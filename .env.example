# Учетные данные хранятся только на локальном сервере и не попадают в Git.
ATOL_LOGIN=
ATOL_PASSWORD=

# Пароль для изменения принадлежности инженеров. Хранится только на сервере.
ENGINEER_ADMIN_PASSWORD=

# По умолчанию браузер работает без окна. false нужен только для диагностики.
ATOL_HEADLESS=true

# Необязательно: явный путь к Chrome или Edge на сервере.
# ATOL_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Сервер сайта. 0.0.0.0 делает его доступным в локальной сети.
APP_HOST=0.0.0.0
PORT=3000

# Постоянные данные. На сервере можно указать абсолютные пути на отдельном диске.
ITS_STATE_PATH=server-data/runtime-state.json
ITS_BACKUP_DIR=server-backups
ITS_BACKUP_RETENTION=30

# Необязательно: отдельная постоянная папка профиля фонового браузера.
ATOL_PROFILE_DIR=.atol-browser-profile
